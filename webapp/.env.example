# Copy to .env.local for local dev, or set these in Render's dashboard for production.

# Postgres connection string (Neon, Render Postgres, etc.)
DATABASE_URL=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cloudflare R2 (audio storage). Omit all five locally to fall back to
# saving audio under public/uploads instead — only required in production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
